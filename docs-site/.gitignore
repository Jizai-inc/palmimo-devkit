# The tree's contract tests enumerate untracked files as well as tracked ones,
# so an unignored install or build directory here fails them wholesale.

# build output
dist/
# generated types
.astro/
# The pages and images sync-doc.mjs renders out of doc/. The tree's copy of a
# page is doc/, never these -- see README.md.
src/content/docs/
public/images/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# The SDK sources and the Python runtime the console loads, staged out of the
# package and out of node_modules by sync-doc.mjs.
public/python/
public/pyodide/
