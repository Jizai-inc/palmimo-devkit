# Sample environment file for the companion agent example.
# Copy this to `.env` (same directory) and fill in your own values:
#   cp .env.sample .env
#
# GEMINI_API_KEY / OPENAI_API_KEY are read directly by LiteLLM (and by
# pipeline.settings.load_settings(), which loads this file into the process
# environment) -- they are deliberately not modeled as settings fields.
# Process environment variables always take precedence over values here. See
# palmimo_companion_agent/settings.py (shared fields) and
# palmimo_companion_agent/pipeline/settings.py (this runtime's own).

# Required if chat_model / guard_model / vlm_model use a "gemini/..." model
# (the default).
GEMINI_API_KEY=your-gemini-api-key-here

# Required if stt_model uses an "openai/..." model (the default).
OPENAI_API_KEY=sk-your-api-key-here

# --- Voice ---------------------------------------------------------------
# TTS backend for the chat front ends: "piper" (synthesizes locally; needs
# the network once, to download its voice) or
# "openai" (hosted -- faster on a Pi and frees the CPU the echo canceller
# wants, but the robot cannot speak without a network). The
# `palmimo-realtime` front end ignores this: there the model's own audio is
# the voice.
#COMPANION_AGENT_VOICE_BACKEND=piper

# Voice name for the openai backend, or the Japanese voice for piper -- a
# piper-plus catalogue key (e.g. ja_JP-tsukuyomi-chan-medium), not a path to a
# model file. To use a voice of your own, put its files in a directory named
# after it under COMPANION_AGENT_VOICE_DIR.
# Unset uses each backend's own default.
#COMPANION_AGENT_VOICE_NAME=

# Which output the speech comes out of: a substring of the ALSA card id or
# its long name, not a card number (numbers move when USB devices are
# replugged). The default names the mic array, whose loopback the echo
# canceller below reads. Empty falls back to whatever ALSA considers default.
#COMPANION_AGENT_SPEAKER_DEVICE=ReSpeaker

# --- Hearing -------------------------------------------------------------
# Cancel the robot's own speech out of the capture. Needs a mic array whose
# reference channel carries the playback.
#COMPANION_AGENT_ECHO_CANCEL=true
#COMPANION_AGENT_NEAR_CHANNEL=0
#COMPANION_AGENT_REFERENCE_CHANNEL=5

# How long the talker must stop before the utterance is treated as finished,
# in seconds. Unset keeps the segmenter's own default. Lower answers sooner
# and interrupts more.
#COMPANION_AGENT_SILENCE_SECONDS=

# --- palmimo-realtime ------------------------------------------------------
# The Realtime voice front end's own knobs (palmimo_companion_agent/realtime/settings.py).
# Needs OPENAI_API_KEY above; ignores every voice_backend/voice_* setting.
#COMPANION_AGENT_MODEL=gpt-realtime-2.1
#COMPANION_AGENT_VOICE=coral
#COMPANION_AGENT_PITCH=1.15
#COMPANION_AGENT_REPLY_CHARS=60
#COMPANION_AGENT_FRAME_SECONDS=10.0
#COMPANION_AGENT_SESSION_SECONDS=120.0
