# Sample environment file for the OpenClaw <-> Palmimo connection kit.
# Don't copy this by hand -- run `make .env`, which copies it, rewrites the
# three OPENCLAW_*_DIR paths below to absolute paths under this directory
# (Docker bind mounts require absolute host paths; relative ones resolve
# against the Docker daemon's own working directory, not this one), and
# generates a random OPENCLAW_GATEWAY_TOKEN.

# Host directories OpenClaw's Docker Compose file binds into the container.
# `make .env` rewrites these three to $(CURDIR)/volumes/... -- left as
# relative placeholders here only so a value always exists before that step.
OPENCLAW_CONFIG_DIR=./volumes/config
OPENCLAW_WORKSPACE_DIR=./volumes/workspace
OPENCLAW_AUTH_PROFILE_SECRET_DIR=./volumes/auth-secrets

# The published image Compose pulls (no repo clone or local build needed).
# Pinned to the release this kit was verified against, matching the Compose
# file the Makefile fetches -- bump both together after re-verifying.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.7.1

# Gateway auth token. `make .env` overwrites this placeholder with a fresh
# `openssl rand -hex 24` value -- never edit it back to something guessable.
OPENCLAW_GATEWAY_TOKEN=<generated-by-make>

# Streamable-HTTP URL of the palmimo_sdk MCP server running on the robot,
# including the /mcp path. Started with:
#   PALMIMO_MCP_TOKEN=<secret> uv run python -m palmimo_sdk.mcp --transport http --host 0.0.0.0 --port 8765
# See doc/guides/mcp-server.md for the full command.
PALMIMO_MCP_URL=http://<robot-host>:8765/mcp

# Shared secret matching the PALMIMO_MCP_TOKEN the robot's MCP server was
# started with. Sent back as an `Authorization: Bearer <token>` header.
PALMIMO_MCP_TOKEN=<shared-secret>

# Optional: an LLM provider key (e.g. ANTHROPIC_API_KEY=...) for OpenClaw to
# actually run chat/tool-calling with, not just discover MCP tools. Compose's
# `env_file: .env` imports every key here straight into the container, so
# adding it here is enough -- configuring which provider/model OpenClaw uses
# is a separate step covered by OpenClaw's own docs (out of scope here).
# ANTHROPIC_API_KEY=
