# Sample environment file for the wake-word agent example.
# Copy this to `.env` (same directory) and fill in your own values:
#   cp .env.sample .env
#
# `.env` is loaded automatically by WakewordAgentSettings; process
# environment variables (e.g. exported in your shell) always take
# precedence over values here. See palmimo_wakeword_agent/settings.py.

# Required: your OpenAI API key, always needed for STT (Whisper transcription
# runs on OpenAI regardless of the command model). Not prefixed with
# WAKEWORD_AGENT_ so it lines up with the `openai` SDK's own default env var.
OPENAI_API_KEY=sk-your-api-key-here

# Required with the default command model (a "gemini-" model): your Gemini
# API key, used against Google's OpenAI-compatible endpoint for command
# tool-calling. Not needed if WAKEWORD_AGENT_COMMAND_MODEL is overridden back
# to a plain OpenAI model (e.g. gpt-5-nano).
GEMINI_API_KEY=your-gemini-api-key-here

# Chat model used for command tool-calling. Defaults to a Gemini model
# (requires GEMINI_API_KEY, see above); set to an OpenAI model (e.g.
# gpt-5-nano) to fall back to OPENAI_API_KEY only.
# WAKEWORD_AGENT_COMMAND_MODEL=gemini-3.5-flash-lite

# Whisper-family transcription model for command text.
# WAKEWORD_AGENT_STT_MODEL=gpt-4o-mini-transcribe

# ISO 639-1 language code driving the Whisper transcription hint, the piper
# TTS voice, and the reply-language instruction given to the LLM. The SDK
# speaker currently ships voices for "en" and "ja".
# WAKEWORD_AGENT_LANGUAGE=en

# Input device name substring hint (MicStream device_name_hint).
# Unset uses the system default input device.
# WAKEWORD_AGENT_DEVICE=

# Output device name substring hint (SpeakerConfig device_name_hint): a
# substring of the ALSA card id or its long name, not a card number (numbers
# move when USB devices are replugged). Empty uses the ALSA default.
# WAKEWORD_AGENT_SPEAKER_DEVICE=ReSpeaker

# Whether to speak replies (requires the `piper` CLI on PATH; set to
# false to disable spoken replies, e.g. no Speaker hardware attached).
# WAKEWORD_AGENT_TTS=true

# Whether to attach the servo driver so commands move a real robot; set to
# false to run compute-only (no servo bus attached at all).
# WAKEWORD_AGENT_SERVO=true

# Servo bus serial port, e.g. /dev/ttyACM0. Unset auto-detects it.
# WAKEWORD_AGENT_SERVO_PORT=
